
&НаСервере
Процедура ОтправитьНаПроверкуНаСервере()
	// Вставить содержимое обработчика. 
	Балл = 0;
	Для Каждого Вопр Из Объект.ВопросыТеста Цикл
		Если Вопр.ОтветСтудента = Вопр.ПравильныйОтвет Тогда
			Балл = Балл + 5;
		КонецЕсли;
		Объект.Балл = Балл;
		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьНаПроверку(Команда)
	ОтправитьНаПроверкуНаСервере();
КонецПроцедуры
